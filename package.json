{
  "name": "omnetpp-ini",
  "displayName": "OMNeT++ INI",
  "description": "Syntax highlighting and '#' comments for OMNeT++ ini files",
  "version": "0.1.0",
  "publisher": "gabrielglzz",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "omnetpp-ini",
        "aliases": [
          "OMNeT++ INI",
          "omnetpp-ini"
        ],
        "extensions": [
          ".ini"
        ],
        "filenames": [
          "omnetpp.ini"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "omnetpp-ini",
        "scopeName": "source.omnetpp-ini",
        "path": "./syntaxes/omnetpp-ini.tmLanguage.json"
      }
    ]
  }
}
