{
  "name": "omnetpp-ini",
  "displayName": "OMNeT++ INI",
  "description": "OMNeT++ ini files: highlighting, '#' comments, completion, hover, go to definition and diagnostics",
  "version": "0.2.0",
  "publisher": "gabrielglzz",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:omnetpp-ini"
  ],
  "contributes": {
    "languages": [
      {
        "id": "omnetpp-ini",
        "aliases": [
          "OMNeT++ INI",
          "omnetpp-ini"
        ],
        "extensions": [
          ".ini"
        ],
        "filenames": [
          "omnetpp.ini"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "omnetpp-ini",
        "scopeName": "source.omnetpp-ini",
        "path": "./syntaxes/omnetpp-ini.tmLanguage.json"
      }
    ]
  }
}
